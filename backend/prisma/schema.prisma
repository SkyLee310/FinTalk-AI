generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MAKER
  CHECKER
  SHARIAH
  SUPERVISOR
  ADMIN
  /// Read-only oversight. Unlike every other role, what it grants is not a
  /// fixed list — it is set per account by canViewMeetings/canViewAuditTrail
  /// below. Supersedes VIEWER and SUPERVISOR, which read as the same person
  /// with the audit trail toggled; see src/auth/rbac.ts.
  OVERSIGHT
}

enum MeetingStatus {
  CAPTURED
  PROCESSING
  READY
  FAILED
}

enum PiiType {
  NRIC
  BANK_ACCOUNT
  PHONE
  EMAIL
  PERSON_NAME
  ADDRESS
  CARD
}

enum ShariahIssueType {
  RIBA
  GHARAR
  MAYSIR
  HARAM_SECTOR
  CONTRACT_MISMATCH
  LATE_PAYMENT_PENALTY
}

enum ShariahStatus {
  FLAGGED
  UNDER_REVIEW
  CLEARED
  CONFIRMED_VIOLATION
}

enum FacilityKind {
  CONVENTIONAL
  ISLAMIC
}

enum IslamicContract {
  MURABAHAH
  TAWARRUQ
  IJARAH
  MUSHARAKAH
  MUDHARABAH
  ISTISNA
  SALAM
}

enum ApprovalStatus {
  DRAFT
  PENDING_CHECKER
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Malaysian payment rails used to disburse a loan. Named for realism in a
/// simulation — no integration with any of them exists, and none is planned
/// in this codebase.
///
/// FPX is retired (banks don't use it for loan disbursement) but stays a
/// valid value: Postgres has no DROP VALUE for an enum, and the same
/// precedent already exists on Role (VIEWER/SUPERVISOR — see the
/// oversight_role migration). src/payments/mock-settlement.ts's
/// SETTLEMENT_RAILS is what actually stops FPX from being offered or
/// accepted going forward.
enum SettlementRail {
  DUITNOW
  FPX
  RENTAS
}

/// PENDING is reachable only through POST /auth/register and never receives a
/// session (login checks this at the same point as deactivatedAt). It has no
/// role and no capability, so nothing else in the system can reference it —
/// which is what lets a rejected PENDING row be hard-deleted safely, unlike
/// every other entity here.
enum AccountStatus {
  PENDING
  ACTIVE
}

/// Three buckets, not a taxonomy. A longer list would make the submitter stop
/// and classify rather than write, and nothing downstream routes on the value.
enum FeedbackCategory {
  BUG
  IDEA
  OTHER
}

/// Whiteboard now covers more than photographs of a physical board: a slide
/// or a scanned/exported document carries the same kind of meeting context.
/// The vision model classifies which on capture; a Word document (no
/// diagram to draw) is classified DOCUMENT directly, without a model call.
enum WhiteboardKind {
  WHITEBOARD
  SLIDE
  DOCUMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  /// Null only while accountStatus is PENDING — a self-registered applicant
  /// has no role until an admin approves them (PATCH /users/:id/approve).
  role          Role?
  /// Meaningful only when role is OVERSIGHT — grants meeting:read +
  /// transcript:read there. Ignored (and kept false) for every other role;
  /// see capabilitiesOf in src/auth/rbac.ts, the only reader of this column.
  canViewMeetings Boolean @default(true)
  /// Meaningful only when role is OVERSIGHT — grants audit:read there. Kept
  /// independent of canViewMeetings on purpose: the audit trail is the more
  /// sensitive of the two surfaces, and this is what lets an administrator
  /// grant one without the other.
  canViewAuditTrail Boolean @default(false)
  /// Existing rows default to ACTIVE: every one of them was admin-created with
  /// a role already assigned, so no backfill judgment call is needed.
  accountStatus AccountStatus @default(ACTIVE)
  /// Collected at self-service sign-up for the approving admin to cross-check
  /// manually. Not a login identifier — login stays email + password. Nullable
  /// because admin-direct-created accounts (POST /users) never collect one.
  username String? @unique
  /// Same nullability reasoning as username. No uniqueness constraint: an
  /// employer's staff ID scheme is not this app's to enforce.
  staffId String?
  createdAt DateTime @default(now())
  /// Set when an administrator revokes access. Deactivated, never deleted: a
  /// User is referenced by audit entries, approvals, settlements and confirmed
  /// segments, and removing the row would orphan attribution the record depends
  /// on. Login refuses a deactivated account.
  deactivatedAt DateTime?

  meetings          Meeting[]
  shariahReviews    ShariahFlag[]       @relation("ShariahReviewer")
  approvalsMade     Approval[]          @relation("Maker")
  approvalsChecked  Approval[]          @relation("Checker")
  humanEdits        HumanEdit[]
  segmentsConfirmed TranscriptSegment[] @relation("SegmentConfirmer")
  settlements       Settlement[]        @relation("Settler")
  feedback          Feedback[]
}

model Meeting {
  id    String @id @default(cuid())
  title String
  /// Operator-typed free text, stored as entered — exactly like `title`, and
  /// carrying exactly the same accepted risk: it can name a person and nothing
  /// redacts it. Redacting it is not currently possible without a fourth
  /// Redaction parent, and storing a placeholder whose vault entry no row could
  /// point at would be worse than storing the text.
  ///
  /// What it does get is the title's discipline: excluded from every audit
  /// payload, so the free text lives in one column rather than being copied into
  /// an append-only log no retention sweep can reach.
  description String?
  occurredAt  DateTime
  status        MeetingStatus @default(CAPTURED)
  failureReason String?
  /// Participants consented to being recorded.
  consentConfirmed Boolean @default(false)
  /// The operator acknowledged that audio crosses the border to Google before
  /// redaction. Deliberately separate from consentConfirmed: consenting to a
  /// recording and accepting a cross-border transfer are two different things,
  /// and one checkbox covering both would evidence neither (spec §12.3).
  /// Existing rows default to false, which is accurate — those uploads were
  /// never shown the disclosure.
  transferAcknowledged Boolean  @default(false)
  createdById          String
  createdAt            DateTime @default(now())
  /// Archive, never delete: TermSheet/Approval/Settlement/ShariahFlag/Transcript
  /// all keep resolving meetingId after this is set. Only GET /meetings' own
  /// query excludes an archived row — GET /meetings/:id still returns it in
  /// full. Set only via PATCH /meetings/:id/archive, restricted to the MAKER
  /// who created it.
  archivedAt DateTime?

  createdBy    User                 @relation(fields: [createdById], references: [id])
  transcript   Transcript?
  whiteboards  Whiteboard[]
  shariahFlags ShariahFlag[]
  termSheets   TermSheet[]
  participants MeetingParticipant[]
  topics       MeetingTopic[]
  decisions    MeetingDecision[]
  actionItems  ActionItem[]

  @@index([createdById])
}

/// Who was in the room, as the operator recorded it.
///
/// `name` is a person's name typed by hand — the single most obviously personal
/// field in this schema — so it is redacted on write and stored as a placeholder
/// with its value sealed in the vault, exactly like an NRIC spoken aloud. The
/// regex detectors cannot find names in free-flowing speech, which the README
/// states plainly; here the operator has told us the field *is* a name, so no
/// detection is needed and none is guessed at.
model MeetingParticipant {
  id        String @id @default(cuid())
  meetingId String
  /// Redacted. Holds a placeholder such as [PERSON_NAME_1], never the name.
  nameRedacted String
  /// Their role in the meeting, e.g. "Credit Manager". Not personal data.
  role String?
  /// Preserves the order the operator entered, so the list reads as they wrote it.
  ordinal Int

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  redactions Redaction[]

  @@index([meetingId, ordinal])
}

/// A decision the meeting reached, distilled by the arbiter from the debate.
///
/// topic/decision/rationale are model output, re-verified with redactDerived
/// before storage — so they hold placeholders where they reference a person,
/// never a name. Best-effort: a meeting with none simply had no decision
/// distilled, not a failed capture.
model MeetingDecision {
  id        String   @id @default(cuid())
  meetingId String
  /// The point that was debated or decided.
  topic     String
  /// The final decision reached, or a statement that it was left unresolved.
  decision  String
  /// The reasoning, or the competing positions where it stayed unresolved.
  rationale String
  /// Display order as the arbiter returned them.
  ordinal   Int
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, ordinal])
}

/// A follow-up action, attributed to a role or speaker label — never a name.
///
/// owner/task/dueDate are model output, re-verified with redactDerived before
/// storage. `owner` is a meeting role or speaker label by construction: the
/// prompt attributes by role, and names are placeholders in the input anyway.
model ActionItem {
  id        String   @id @default(cuid())
  meetingId String
  /// A meeting role or speaker label. Never a personal name.
  owner     String
  /// What is to be done.
  task      String
  /// A due date as stated in the meeting, free text, or null if none was given.
  dueDate   String?
  /// Display order as the extractor returned them.
  ordinal   Int
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, ordinal])
}

/// rawRedacted and summaryEn are only ever written with redacted content.
/// The RedactedText branded type (Plan 2) enforces this at the call site.
model Transcript {
  id            String   @id @default(cuid())
  meetingId     String   @unique
  rawRedacted   String
  summaryEn     String
  languages     String[]
  modelId       String
  promptVersion String
  createdAt     DateTime @default(now())

  /// Wall-clock milliseconds the capture pipeline took, from entry to the
  /// transcript-writing transaction — transcription, redaction, summarisation
  /// and persistence. Null on rows written before this existed and on the seed
  /// fixture. Surfaced on the meeting page as how long processing took.
  processingMs  Int?

  /// Embedding of summaryEn, for cross-meeting similarity.
  ///
  /// Stored as a plain float array, not pgvector: Railway's Postgres image
  /// cannot be assumed to carry the extension, and cosine similarity over a
  /// demo-sized corpus is a millisecond loop in Node. That is a real scale
  /// ceiling — see findRelatedMeetings in src/knowledge/graph.ts, which says so
  /// where someone would hit it.
  ///
  /// Empty when not yet embedded. Derived from already-redacted text, so it
  /// encodes placeholders rather than identifiers.
  summaryEmbedding Float[]

  /// AI-drafted project kickoff, derived from the redacted transcript and
  /// re-verified with redactDerived before storage. Null when no provider
  /// produced it or a PII check skipped it — never a reason to fail the capture.
  projectKickoffRedacted String?
  /// Probable follow-up actions, one prose line each. Same derivation and
  /// verification as the kickoff; empty when none were produced.
  followUpsRedacted String[]

  meeting    Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]
  redactions Redaction[]
}

/// A topic a meeting discussed, extracted from its already-redacted summary.
///
/// This is what a knowledge-graph edge is made of. Deliberately never a person:
/// redaction contexts are per-meeting, so [NRIC_1] in one meeting and [NRIC_1]
/// in another are different people, and an edge drawn between them would assert
/// a relationship that does not exist.
model MeetingTopic {
  id        String @id @default(cuid())
  meetingId String
  /// Normalised lower-case label, e.g. "murabahah" or "working capital".
  label String
  /// What kind of thing it is: CONTRACT, SECTOR, PRODUCT, ISSUE or TERM.
  kind String
  /// 0–1. How central the extractor judged it to the discussion.
  weight Float

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, label])
  @@index([label])
}

model TranscriptSegment {
  id           String @id @default(cuid())
  transcriptId String
  startMs      Int
  endMs        Int
  speakerLabel String
  textRedacted String
  /// The model's self-reported certainty about this segment, 0–1.
  ///
  /// Nullable, and null means "not scored" rather than "scored zero" or
  /// "scored one". Segments captured before scoring existed, and providers that
  /// report nothing, both land here honestly. Defaulting to 1.0 would mark
  /// every unscored segment as maximally trustworthy — the opposite of true.
  ///
  /// Not a calibrated probability. See SegmentDraft.confidence in
  /// src/ai/provider.ts for why, and for what the UI is required to call it.
  confidence Float?
  /// Set when a human read this segment and said the text was right. Distinct
  /// from a high confidence score: one is a person's assertion, the other is a
  /// model's. Null means nobody has looked.
  confirmedById String?
  confirmedAt   DateTime?

  transcript  Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  confirmedBy User?      @relation("SegmentConfirmer", fields: [confirmedById], references: [id])
  /// Shariah findings anchored to this segment, for "jump to transcript".
  /// See ShariahFlag.segmentId.
  shariahFlags ShariahFlag[]

  @@index([transcriptId, startMs])
}

/// Exactly one of transcriptId, whiteboardId or participantId is set — see
/// prisma/sql/constraints.sql, constraint redaction_single_parent.
///
/// The third parent exists because a participant's name is the most plainly
/// personal field in this schema, and it gets the same treatment as an NRIC
/// spoken aloud: sealed in the vault, replaced by a placeholder, logged here.
/// Offsets into a one-field parent are degenerate (0 to length) but the row
/// still ties a vault entry to exactly one thing, which is what this table is
/// for. A vault entry with no redaction row pointing at it would be an
/// identifier nobody could account for.
model Redaction {
  id            String  @id @default(cuid())
  transcriptId  String?
  whiteboardId  String?
  participantId String?
  piiType       PiiType
  placeholder   String
  startOffset   Int
  endOffset     Int
  detectedBy    String
  confidence    Float
  vaultId       String? @unique

  transcript  Transcript?         @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  whiteboard  Whiteboard?         @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  participant MeetingParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  vault       PiiVault?           @relation(fields: [vaultId], references: [id])

  @@index([transcriptId])
  @@index([whiteboardId])
  @@index([participantId])
}

/// AES-256-GCM only. There is deliberately no plaintext column.
model PiiVault {
  id         String   @id @default(cuid())
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  createdAt  DateTime @default(now())

  redaction Redaction?
}

/// The source image is never persisted — only derived artifacts.
model Whiteboard {
  id        String         @id @default(cuid())
  meetingId String
  kind      WhiteboardKind @default(WHITEBOARD)
  /// The canonical redacted text. Redaction offsets index into this field, the
  /// same contract Transcript.rawRedacted carries.
  rawRedacted String
  /// Null for a DOCUMENT capture — a Word file has no diagram to draw.
  mermaid        String?
  structuredJson Json
  modelId        String
  promptVersion  String
  createdAt      DateTime @default(now())

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  redactions Redaction[]

  @@index([meetingId])
}

/// status may only leave FLAGGED via a user holding Role.SHARIAH (Plan 4).
model ShariahFlag {
  id         String           @id @default(cuid())
  meetingId  String
  issueType  ShariahIssueType
  excerpt    String
  detectedBy String
  confidence Float
  reference  String
  status     ShariahStatus    @default(FLAGGED)
  createdAt  DateTime         @default(now())

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  /// Which transcript segment the finding's anchor match falls in, for
  /// "jump to transcript". Null for a flag raised before this column
  /// existed, or the rare case the offset could not be resolved — the
  /// finding is still valid either way, just not linkable to one line.
  /// SetNull rather than Cascade: a segment's correction shouldn't delete
  /// the finding it once helped locate.
  segmentId String?
  /// The distinct phrases matched within the finding's sentence, for
  /// highlighting inside `excerpt`. Empty for a flag raised before this
  /// column existed.
  highlights String[] @default([])

  meeting    Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("ShariahReviewer", fields: [reviewedById], references: [id])
  segment    TranscriptSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
}

/// interestRateBps and profitRateBps are mutually exclusive.
/// Enforced by term_sheet_rate_kind_exclusive in prisma/sql/constraints.sql.
model TermSheet {
  id              String           @id @default(cuid())
  meetingId       String
  applicantName   String
  currency        String           @default("MYR")
  principalMinor  BigInt
  tenureMonths    Int
  facilityKind    FacilityKind
  interestRateBps Int?
  profitRateBps   Int?
  islamicContract IslamicContract?
  status          ApprovalStatus   @default(DRAFT)
  createdAt       DateTime         @default(now())

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  approval   Approval?
  settlement Settlement?

  @@index([meetingId])
}

/// A **simulated** settlement. No money moves and no bank is contacted.
///
/// `simulated` carries a `CHECK (simulated = true)` in prisma/sql/constraints.sql,
/// so a row cannot be edited to look real without a migration that shows up in
/// review. `mockReference` is always prefixed MOCK- for the same reason: a
/// reference that could pass for a genuine DuitNow one in a screenshot would be
/// the whole problem.
///
/// One settlement per term sheet, enforced by the unique key rather than by a
/// service check, because "we already paid this" is not a race to lose.
model Settlement {
  id            String         @id @default(cuid())
  termSheetId   String         @unique
  rail          SettlementRail
  /// Always MOCK-<RAIL>-<random>. Never a plausible real reference.
  mockReference String         @unique
  /// Minor units, copied from the approved term sheet — never from a request.
  amountMinor BigInt
  currency    String
  settledById String
  settledAt   DateTime @default(now())
  /// Always true. The CHECK constraint makes false unstorable.
  simulated Boolean @default(true)

  termSheet TermSheet @relation(fields: [termSheetId], references: [id], onDelete: Cascade)
  settledBy User      @relation("Settler", fields: [settledById], references: [id])

  @@index([settledById])
}

/// checkerId != makerId is enforced by approval_checker_not_maker.
model Approval {
  id          String         @id @default(cuid())
  termSheetId String         @unique
  makerId     String
  submittedAt DateTime       @default(now())
  checkerId   String?
  decidedAt   DateTime?
  decision    ApprovalStatus @default(PENDING_CHECKER)
  note        String?

  termSheet TermSheet @relation(fields: [termSheetId], references: [id], onDelete: Cascade)
  maker     User      @relation("Maker", fields: [makerId], references: [id])
  checker   User?     @relation("Checker", fields: [checkerId], references: [id])
}

model AiOutputSnapshot {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  modelId        String
  promptVersion  String
  promptRedacted String
  responseRaw    Json
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
}

model HumanEdit {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  editorId   String
  fieldPath  String
  aiValue    String
  humanValue String
  editedAt   DateTime @default(now())

  editor User @relation(fields: [editorId], references: [id])

  @@index([entityType, entityId])
}

/// Append-only. UPDATE and DELETE raise via triggers in constraints.sql.
model AuditEntry {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String
  payload    Json
  prevHash   String
  hash       String   @unique

  @@index([entityType, entityId])
  @@index([at])
}

/// Free-text feedback from a signed-in user.
///
/// Not RedactedText: that write path exists for text derived from AI, audio or
/// images, where the author never saw what was captured. This is typed by the
/// person submitting it. The route refuses a submission containing personal
/// data instead, the same way ask() refuses a query carrying one — see
/// feedback.routes.ts.
model Feedback {
  id        String           @id @default(cuid())
  authorId  String
  category  FeedbackCategory
  message   String
  createdAt DateTime         @default(now())

  /// No onDelete: Cascade. Accounts are deactivated, never deleted, and
  /// feedback outliving its author is the correct outcome anyway.
  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
}
