# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit it.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

# --- Database (Railway injects DATABASE_URL in production) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintalk

# --- Transcription provider: gemini | vertex | fake ---
# Use "fake" for tests and development with no API key.
# A "local" on-device provider was withdrawn on 2026-08-10. Setting it now
# stops the server at boot rather than quietly using Gemini instead.
TRANSCRIPTION_PROVIDER=fake

# --- Gemini (required only when TRANSCRIPTION_PROVIDER=gemini) ---
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Read the current model IDs from AI Studio's model list and paste them here.
# Never hardcode a model ID in source.
GEMINI_MODEL_TRANSCRIBE=
GEMINI_MODEL_VISION=
GEMINI_MODEL_TEXT=
# Optional, unlike the three above. Without it the knowledge graph connects
# meetings by shared topics only, and Ask FinTalk AI reports itself unavailable
# instead of answering. Both degrade honestly rather than failing at boot.
GEMINI_MODEL_EMBEDDING=

# --- Vertex AI (required only when TRANSCRIPTION_PROVIDER=vertex) ---
# The same Gemini models, authenticated as a GCP service account instead of
# an API key. Use this instead of TRANSCRIPTION_PROVIDER=gemini when the
# deployment needs GCP-side IAM/audit control over model access.
# Project id: also the "project_id" field inside your service account's own
# JSON key, so it never needs to be looked up separately.
VERTEX_PROJECT_ID=
# Region where Vertex AI is enabled for that project, e.g. us-central1.
VERTEX_LOCATION=
# The service account key's JSON *contents*, not a path to the file — paste
# the whole downloaded .json file's content as one value. Requires the
# Vertex AI API (aiplatform.googleapis.com) and billing enabled on the project.
GCP_SERVICE_ACCOUNT_KEY=
# Vertex's Model Garden doesn't always expose the same model ids as AI
# Studio for the same underlying model — recheck rather than reusing the
# GEMINI_MODEL_* values above.
VERTEX_MODEL_TRANSCRIBE=
VERTEX_MODEL_VISION=
VERTEX_MODEL_TEXT=
# Optional, same reasoning as GEMINI_MODEL_EMBEDDING above.
VERTEX_MODEL_EMBEDDING=

# --- OpenRouter (optional automatic fallback for TRANSCRIPTION_PROVIDER=gemini or vertex) ---
# Key: https://openrouter.ai/keys
# Leave blank and Gemini behaves exactly as it did before this existed. Set
# it and every Gemini call gets one retry against OpenRouter before the
# request fails — no other config needed, the two model ids below already
# default to widely available OpenRouter models.
OPENROUTER_API_KEY=
# Text + vision model, used for every task except transcribe and embed.
# Defaults to openai/gpt-4o.
OPENROUTER_MODEL=
# Defaults to openai/whisper-large-v3. OpenRouter's transcription has no
# speaker diarization, so a fallback transcript reports one speaker for the
# whole clip rather than guessing who said what.
OPENROUTER_MODEL_TRANSCRIBE=

AI_REQUEST_TIMEOUT_MS=30000

# --- Auth (min 32 chars each; generate: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- PII vault (AES-256-GCM; exactly 32 bytes, base64) ---
# Generate: openssl rand -base64 32
PII_VAULT_KEY=

# --- PDPA retention window ---
MEETING_RETENTION_DAYS=90
